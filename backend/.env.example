# CampusBite Spring Boot Backend Environment Variables
# Copy this file to .env or set these in your local OS / IDE (IntelliJ, Eclipse, VS Code)

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campusbite_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JPA_DDL_AUTO=update
SHOW_SQL=true

# Security & JWT Configuration (Must be at least 256 bits / 32 characters in base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs where the React frontend runs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Canteen Capacity Constraints
MAX_ORDERS_PER_SLOT=10
